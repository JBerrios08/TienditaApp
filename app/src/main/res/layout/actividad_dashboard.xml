<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/fondo_dashboard">

    <!-- Barra superior con título y botón de cerrar sesión -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/tituloDashboard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true"/>

        <Button
            android:id="@+id/botonCerrarSesion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cerrar sesión"
            android:textColor="#FFFFFF"
            android:background="@color/color_boton"
            android:layout_alignParentEnd="true"/>
    </RelativeLayout>

    <!-- Sección de productos registrados y stock total -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="2">

        <TextView
            android:id="@+id/productosRegistrados"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Productos Registrados: 13"
            android:textSize="18sp"
            android:layout_weight="1"/>

        <TextView
            android:id="@+id/stockTotal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Stock Total: 273"
            android:textSize="18sp"
            android:layout_weight="1"/>
    </LinearLayout>

    <!-- Lista de productos recientes -->
    <RecyclerView
        android:id="@+id/listaProductosRecientes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>

</LinearLayout>

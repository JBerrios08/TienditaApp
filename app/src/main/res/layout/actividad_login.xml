<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_login">

    <!-- Logo -->
    <ImageView
        android:id="@+id/logoLogin"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_centerHorizontal="true"
        android:src="@drawable/logo" />

    <!-- Campo de Usuario -->
    <EditText
        android:id="@+id/usuario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/logoLogin"
        android:layout_marginTop="50dp"
        android:hint="Usuario"
        android:padding="10dp"
        android:inputType="text" /> <!-- Campo de Usuario -->

    <!-- Campo de Contraseña -->
    <EditText
        android:id="@+id/contrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/usuario"
        android:layout_marginTop="20dp"
        android:hint="Contraseña"
        android:padding="10dp"
        android:background="@drawable/input_redondeado"
        android:inputType="textPassword" /> <!-- Campo de Contraseña -->

    <!-- Botón Ingresar -->
    <Button
        android:id="@+id/botonIngresar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/contrasena"
        android:layout_marginTop="20dp"
        android:text="Ingresar"
        android:textColor="#FFFFFF"
        android:background="@color/color_boton" />

</RelativeLayout>
